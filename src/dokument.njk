---
layout: bas.njk
titel: Dokument
permalink: /dokument/
---
<h1>Dokument</h1>

<section>
  <h2>Stadgar</h2>
  <ul class="dokumentlista">
    <li><a href="{{ dokument.stadgar.fil | fileUrl }}">{{ dokument.stadgar.titel }}</a> <span class="typ">PDF</span>
      <p>{{ dokument.stadgar.beskrivning }}</p></li>
  </ul>
</section>

<section>
  <h2>Årsredovisningar</h2>
  <ul class="dokumentlista">
    {%- for r in arkiv.arsredovisningar %}
    <li><a href="{{ ("filer/arsredovisningar/" + r.fil) | fileUrl }}">Årsredovisning {{ r.ar }}</a> <span class="typ">PDF</span></li>
    {%- endfor %}
  </ul>
</section>

<section>
  <h2>Lagar och förteckningar</h2>
  <ul class="dokumentlista">
    {%- for d in dokument.ovriga %}
    <li><a href="{{ d | dokumentUrl }}">{{ d.titel }}</a>
      {% if d.beskrivning %}<p>{{ d.beskrivning }}</p>{% endif %}</li>
    {%- endfor %}
  </ul>
</section>

<section>
  <h2>Historiska bilder och kartor</h2>
  <ul class="lankar">
    {%- for b in dokument.bilder %}
    <li><a href="{{ b | dokumentUrl }}">{{ b.titel }}</a></li>
    {%- endfor %}
    {%- for k in dokument.kartor %}
    <li><a href="{{ k | dokumentUrl }}">{{ k.titel }}</a> <span class="typ">karta</span></li>
    {%- endfor %}
  </ul>
</section>

<section>
  <h2>Fastighetsritningar</h2>
  <p>Ritningar ur Stadsbyggnadskontorets arkiv, 1897–2011.</p>
  <ul class="ritningar">
    {%- for r in arkiv.ritningar %}
    <li><a href="{{ ("filer/ritningar/" + r.fil) | fileUrl }}">{{ r.titel }}</a></li>
    {%- endfor %}
  </ul>
</section>
