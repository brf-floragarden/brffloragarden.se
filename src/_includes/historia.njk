---
layout: bas.njk
---
<p class="overrubrik">Sedan 1897</p>
<h1>{{ rubrik }}</h1>

<div class="intro{% if bild %} med-bild{% endif %}">
  <div class="text">
  {{ content | safe }}
  </div>
  {% if bild %}
  <figure>
    <a href="{{ bild | fileUrl }}"><img src="{{ bild | fileUrl }}" alt="{{ bildtext }}"></a>
    {% if bildtext %}<figcaption>{{ bildtext }}</figcaption>{% endif %}
  </figure>
  {% endif %}
</div>

<h2>{{ tidslinjeRubrik }}</h2>
<ol class="tidslinje">
  {%- for h in handelser %}
  <li><strong>{{ h.ar }}</strong> {{ h.text }}</li>
  {%- endfor %}
</ol>
