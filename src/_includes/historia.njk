---
layout: bas.njk
---
{% if omslag %}
<figure class="omslag-figur">
  <header class="omslag">
    <img src="{{ omslag | fileUrl }}" alt="{{ omslagText }}">
    <div>
      <p class="overrubrik">Sedan 1897</p>
      <h1>{{ rubrik }}</h1>
    </div>
  </header>
  {% if omslagText %}<figcaption>{{ omslagText }}</figcaption>{% endif %}
</figure>
{% else %}
<p class="overrubrik">Sedan 1897</p>
<h1>{{ rubrik }}</h1>
{% endif %}

<div class="text">
{{ content | safe }}
</div>

<h2>{{ tidslinjeRubrik }}</h2>
<ol class="tidslinje">
  {%- for h in handelser %}
  <li><strong>{{ h.ar }}</strong> {{ h.text }}</li>
  {%- endfor %}
</ol>
